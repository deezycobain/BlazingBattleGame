{
  "schema_version": 1,
  "status": "preproduction_not_summonable",
  "purpose": "Add genuine low-rarity original units to standard summons without replacing exclusive or approved fighter pools",
  "ordinary_banner_policy": {
    "name": "Shinobi Recruitment",
    "odds_percent": {
      "Common": 68,
      "Uncommon": 23,
      "Rare": 8,
      "Legendary": 1
    },
    "exclusive_units_excluded": true,
    "apply_when": "At least six QA-approved playable Commons have canonical unit.json, runtime-map.json, card art, idle, basic and recoil; summon integration and server-authoritative RNG remain separate work"
  },
  "new_player_ownership": {
    "starting_units": [
      "tyler",
      "subzero",
      "senku"
    ],
    "do_not_grant_recruits_automatically": true
  },
  "rules": [
    "Existing Road enemies remain enemies until separately authored as player units; never mutate their combat definitions in place",
    "Never mark concepts or mismatched atlas art playable",
    "Canonical recruitment units require distinct character folders and approved battle/card animation resources",
    "New Common units have basic attacks and simple roles; exotic Jutsu, Light/Dark types, event exclusivity, and premium traits stay rare",
    "Do not change live Legacy or Treasury pools as part of asset intake"
  ],
